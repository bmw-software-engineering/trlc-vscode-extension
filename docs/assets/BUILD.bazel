load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

# Plain filegroup() can't be consumed cross-package by copy_to_bin-based
# rules (like vsce's packaging action) - copy_to_bin here once, in the
# icon's own package, makes it a bin-rooted artifact so it can be.
copy_to_bin(
    name = "assets",
    srcs = ["BMW_White-Colour_RGB.png"],
    visibility = ["//visibility:public"],
)
