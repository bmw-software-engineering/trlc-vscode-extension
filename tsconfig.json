{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "sourceMap": true,
        "rootDir": "src/client/src",
        "outDir": "src/client/.tsc-out",
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedParameters": true,
        "types": ["node", "vscode"]
    },
    "include": [
        "src/client/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "bazel-*"
    ]
}
