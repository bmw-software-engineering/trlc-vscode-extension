# VSCode desktop build, linux-x64. Pinned version tracked in extensions.bzl.
alias(
    name = "code",
    actual = "VSCode-linux-x64/code",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "tree",
    srcs = glob(["VSCode-linux-x64/**"], exclude_directories = 0),
    visibility = ["//visibility:public"],
)
