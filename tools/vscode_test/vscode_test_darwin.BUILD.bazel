# VSCode desktop build, darwin-arm64. Pinned version tracked in extensions.bzl.
#
# @vscode/test-electron's resolveCliPathFromVSCodeExecutablePath expects the
# Electron binary *inside* the .app bundle for darwin (it derives the actual
# CLI as "../../../Contents/Resources/app/bin/code" from whatever path it's
# given) - so, unlike the linux-x64 "code" alias, this points at the
# Electron binary, not a top-level launcher script.
alias(
    name = "code",
    actual = "Visual Studio Code.app/Contents/MacOS/Electron",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "tree",
    srcs = glob(["Visual Studio Code.app/**"], exclude_directories = 0),
    visibility = ["//visibility:public"],
)
