# VSCode desktop build, win32-x64. Pinned version tracked in extensions.bzl.
#
# Unlike the linux-x64 tarball (nested under "VSCode-linux-x64/") or the
# darwin zip (a "Visual Studio Code.app/" bundle), the win32-x64 "-archive"
# variant unzips flat, with Code.exe directly at the archive root.
alias(
    name = "code",
    actual = "Code.exe",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "tree",
    srcs = glob(
        ["**"],
        exclude_directories = 0,
    ),
    visibility = ["//visibility:public"],
)
