"""Definition of the linter binaries.

In its own package so builds that don't request lint don't eagerly fetch
the pylint binary/dependencies.
"""

load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(default_visibility = ["//:__subpackages__"])

eslint_bin.eslint_binary(
    name = "eslint",
    # rules_lint's bundled formatter script (lint/js/eslint.stylish-
    # formatter.js) does a bare `require("chalk")` with no dep of its own
    # wired for it - it expects the consuming repo to make chalk
    # resolvable. Added as a real devDependency for exactly this.
    data = ["//:node_modules/chalk"],
)

py_console_script_binary(
    name = "pylint",
    pkg = "@pip//pylint:pkg",
    # rules_lint's pylint_action doesn't wire PYTHONPATH from the linted
    # target's own deps (see lint/pylint.bzl - it only passes source files
    # to the pylint action). The only way for pylint to resolve imports of
    # the server package and its runtime/test deps is for them to be on
    # this binary's own PYTHONPATH via standard py_binary dep propagation.
    deps = [
        "//src/server",
        "@pip//lsprotocol",
        "@pip//pygls",
        "@pip//pytest",
        "@pip//pytest_lsp",
        "@pip//trlc",
    ],
)
