{
    "name": "trlc-vscode-extension",
    "version": "4.0.0",
    "publisher": "bmw-group",
    "author": {
        "name": "BMW Group"
    },
    "engines": {
        "node": ">=22.13.0",
        "vscode": ">=1.91.0"
    },
    "packageManager": "pnpm@11.13.1",
    "icon": "docs/assets/BMW_White-Colour_RGB.png",
    "files": [
        "package.json",
        "LICENSE",
        "README.md",
        "CHANGELOG.md",
        "trlc-grammar.json",
        "trlc-language-configuration.json",
        "docs/assets/BMW_White-Colour_RGB.png",
        "src/client/out/extension.js",
        "src/server/**/*.py"
    ],
    "license": "GPL-3.0-or-later",
    "displayName": "TRLC VSCode Extension",
    "description": "VSCode integration for the Python TRLC reference implementation",
    "homepage": "https://github.com/bmw-software-engineering/trlc-vscode-extension",
    "bugs": {
        "url": "https://github.com/bmw-software-engineering/trlc-vscode-extension/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/bmw-software-engineering/trlc-vscode-extension.git"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "keywords": [
        "trlc",
        "requirements",
        "plain text",
        "bmw"
    ],
    "extensionDependencies": [
        "ms-python.python"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.13.0",
        "@types/sinon": "^17.0.4",
        "@types/vscode": "^1.91.0",
        "@vscode/test-electron": "^3.0.0",
        "@vscode/vsce": "^3.9.2",
        "chalk": "^4.1.2",
        "eslint": "^10.7.0",
        "mocha": "^11.7.5",
        "sinon": "^19.0.2",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0"
    },
    "dependencies": {
        "vscode-languageclient": "^10.1.0"
    },
    "scripts": {
        "test": "mocha",
        "test:e2e": "ts-node tests/e2e/runTest.ts"
    },
    "main": "src/client/out/extension",
    "activationEvents": [
        "onLanguage:TRLC"
    ],
    "contributes": {
        "languages": [
            {
                "id": "TRLC",
                "extensions": [
                    ".rsl",
                    ".trlc"
                ],
                "configuration": "./trlc-language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "TRLC",
                "scopeName": "source.trlc",
                "path": "./trlc-grammar.json"
            }
        ],
        "commands": [
            {
                "command": "extension.parseAll",
                "title": "TRLC: Parse All"
            },
            {
                "command": "extension.resetState",
                "title": "TRLC: Reset Setup"
            },
            {
                "command": "extension.showTrlcOutput",
                "title": "TRLC: Show Output"
            },
            {
                "command": "extension.showTrlcFilesInScope",
                "title": "TRLC: Show Files In Scope"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "trlc-vscode-extension server configuration",
            "properties": {
                "trlcServer.parseMode": {
                    "scope": "resource",
                    "type": "string",
                    "enum": ["workspace", "directory", "repo", "bazel"],
                    "default": "workspace",
                    "description": "Controls file discovery strategy. workspace: open files + includes (fast, interactive); directory: single directory non-recursive (monorepos); repo: all .rsl/.trlc files (needed for rename/references); bazel: Bazel TRLC targets (requires WORKSPACE/MODULE.bazel)."
                },
                "trlcServer.verify": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Enable CVC5 formal verification of checks. Significantly increases parse time."
                },
                "trlcServer.excludePatterns": {
                    "scope": "window",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Regex patterns matched against directory names to exclude from TRLC include scanning. The pattern `^bazel-.*$` is always applied by default."
                },
                "trlcServer.bazel.executable": {
                    "scope": "resource",
                    "type": "string",
                    "default": "bazel",
                    "description": "Path to the bazel executable for parseMode: bazel."
                },
                "trlcServer.bazel.ruleClasses": {
                    "scope": "resource",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": ["_trlc_specification", "_trlc_requirement", "_trlc_rst", "_score_requirements_rule", "feature_requirements", "component_requirements", "assumed_system_requirements", "fmea"],
                    "description": "Bazel rule class names (internal/private rule names from trlc.bzl) to include in parseMode: bazel discovery. Customize for third-party TRLC macros."
                },
                "trlcServer.bazel.useSharedServer": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": false,
                    "description": "If true, reuse the default Bazel server (faster but may interfere with your build). If false, use a dedicated output_base per workspace."
                },
                "trlcServer.bazel.queryTimeoutSeconds": {
                    "scope": "resource",
                    "type": "number",
                    "default": 180,
                    "description": "Timeout (seconds) for a single 'bazel query' call. The first query against a fresh/cold Bazel server (the default unless useSharedServer is true) can take much longer than a warm-server query, especially on large repos or slow filesystems."
                },
                "trlcServer.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": ["off", "messages", "verbose"],
                    "default": "off",
                    "description": "Traces communication between VS Code and the TRLC language server. Set to 'verbose' and check the '[pygls] TrlcLanguageServer' Output channel to diagnose why a file isn't parsing as expected."
                },
                "trlcServer.logLevel": {
                    "scope": "window",
                    "type": "string",
                    "enum": ["debug", "info", "warning", "error"],
                    "default": "warning",
                    "description": "Sets the verbosity of TRLC's diagnostic logging (client and server), shown in the '[pygls] TrlcLanguageServer' output channel and written to a rotating log file. This is separate from Trlc Server > Trace: Server, which only traces the LSP wire protocol."
                },
                "trlcServer.hover.descriptionComponent": {
                    "scope": "resource",
                    "type": "string",
                    "default": "description",
                    "description": "Component name whose string value is shown on hover when hovering a reference to a record object (e.g. the target of a derived_from entry). Set to an empty string to disable. Only affects object instances - hovering a type/tuple/enum name always shows its own TRLC RSL doc comment, independent of this setting."
                }
            }
        },
        "configurationDefaults": {
            "[TRLC]": {
                "editor.wordBasedSuggestions": "off"
            }
        }
    }
}
